# ---------------------------------------------------------------------------
# Transcript & Credential Verifier - backend environment variables
#
# Copy this file to `.env` and fill in real values for anything beyond local
# dev. Every variable below is read via python-decouple's config().
# ---------------------------------------------------------------------------

# --- Core Django -------------------------------------------------------------
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# --- USE_SQLITE toggle --------------------------------------------------------
# True  (default): backend runs on local SQLite, and EVERY external Azure
#         service below runs in deterministic-stub mode automatically -
#         no network calls, no Azure resources, no cost. This is the mode
#         `manage.py test` and CI always run in.
# False: backend connects to real Postgres (see POSTGRES_* below). Postgres
#         here is plain relational only - no pgvector/vector extension is
#         needed, because all embedding/vector storage goes through the
#         Azure AI Search abstraction in apps/common/search_store.py, never
#         through Postgres columns. Azure services still individually stub
#         out if their own AZURE_*/OPENAI_* variables below are left blank -
#         flipping USE_SQLITE to False does not, by itself, require any
#         Azure credentials to be set.
USE_SQLITE=True

# --- Postgres (used only when USE_SQLITE=False) -------------------------------
# Native Postgres, no extensions required. Local dev default points at a
# Postgres server already running on localhost:5432 with a matching
# database/role already created.
POSTGRES_DB=transcript_credential_verifier
POSTGRES_USER=transcript_credential_verifier
POSTGRES_PASSWORD=transcript_credential_verifier
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Azure Blob Storage (apps/common/blob_store.py) ---------------------------
# Optional. When set, uploaded transcripts/certificates/diplomas are stored
# in real Azure Blob Storage via azure-storage-blob. When left blank, files
# are written to/read from MEDIA_ROOT/blob_stub/<container>/ on local disk -
# same function signatures either way, nothing else in the app changes.
AZURE_STORAGE_CONNECTION_STRING=

# --- Azure AI Document Intelligence (apps/common/document_intelligence.py) ----
# Optional. When both are set, uploaded documents are analyzed with the real
# Azure Document Intelligence service (production should use a custom-trained
# transcript model; "prebuilt-document" is used here as a generic fallback).
# When blank, a deterministic stub parses the uploaded text directly into
# course/grade/term rows (SHA256-seeded for any line it can't parse cleanly),
# so results are reproducible across test runs.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# --- Azure OpenAI (apps/common/ai.py) - chat + embeddings ---------------------
# Optional. When both endpoint and key are set, real Azure OpenAI chat
# completions and embeddings are used (via the `openai` package's
# AzureOpenAI client). When blank, chat replies and embedding vectors are
# generated deterministically from a SHA256 seed of the input text - same
# input always produces the same stub output, so search/equivalency results
# are reproducible without any real AI calls.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Chat model deployment/name. Defaults to gpt-5.4-mini for this app.
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Embedding model deployment/name. Defaults to text-embedding-3-large, 1536 dims.
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Azure AI Search (apps/common/search_store.py) -----------------------------
# Optional. When both are set, coursework chunk vectors are upserted into /
# searched from a real Azure AI Search index ("credential_chunks") via
# azure-search-documents. When blank, an in-process, in-memory fallback
# (plain Python list + cosine similarity, no external deps, no persistence
# needed beyond a single process/test run) stands in for the index.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
